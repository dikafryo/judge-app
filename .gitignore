# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 서명 키는 절대 저장소에 들어오면 안 된다.
# 실제 키는 ~/.config/judge-app/ 에 있고 여기 올 일이 없지만, 실수를 막는 안전망이다.
# (android/release-signing.sha256 은 인증서 지문이라 공개돼도 무방하며, 게시 스크립트가 대조에 쓴다)
*.jks
*.keystore
key.properties

# 머신마다 다른 절대 경로가 들어간다
/android/local.properties
